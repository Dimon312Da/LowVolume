<?xml version="1.0" encoding="utf-8"?>
<!-- Пароль и настройки не переносятся через облачные копии и на другие устройства. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
